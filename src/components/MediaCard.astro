---
// 根据具有明确类型的 `type` 字段渲染一条媒体内容。
// 视频没有 src 时使用封面图作为回退，不输出损坏的 <video> 元素。
import type { MediaItem } from "../data/siteData";
import OptimizedImage from "./OptimizedImage.astro";
import { withBase } from "../utils/paths";

type Props = {
  item: MediaItem;
};

const { item } = Astro.props;
const poster = item.poster || "/assets/images/video-poster.png";
const recordImage = item.src || "/assets/images/media-stage.png";
---

{
  item.type === "record" ? (
    <article class="media-card media-card-record">
      <div class="media-frame">
        <OptimizedImage src={recordImage} alt={item.title} loading="lazy" />
      </div>
      <div class="media-meta">
        <span class="record-chip">记录</span>
        <strong>{item.title}</strong>
        <span>{item.caption}</span>
      </div>
    </article>
  ) : item.type === "video" ? (
    <article class="media-card">
      <div class="media-frame media-frame-video">
        {item.src ? <video src={withBase(item.src)} poster={withBase(poster)} controls preload="none" /> : <OptimizedImage src={poster} alt={item.title} loading="lazy" />}
        <span class="play-chip">PLAY</span>
      </div>
      <div class="media-meta">
        <strong>{item.title}</strong>
        <span>{item.caption || "视频素材待添加"}</span>
      </div>
    </article>
  ) : (
    <article class="media-card">
      <div class="media-frame">
        <OptimizedImage src={item.src} alt={item.title} loading="lazy" />
      </div>
      <div class="media-meta">
        <strong>{item.title}</strong>
        <span>{item.caption}</span>
      </div>
    </article>
  )
}
