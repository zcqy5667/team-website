---
// 通用页脚。详情页和分类页可以通过可选参数显示返回链接。
import { withBase } from "../utils/paths";

type Props = {
  backHref?: string;
  backLabel?: string;
};

const { backHref, backLabel } = Astro.props;
---

{
  backHref && backLabel ? (
    <footer class="site-footer">
      <span>RoboMaster Team Showcase</span>
      <a href={withBase(backHref)}>{backLabel}</a>
    </footer>
  ) : null
}
