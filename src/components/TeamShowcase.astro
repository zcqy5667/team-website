---
// 首页的战队介绍区块。这里直接接收完整 Team 对象，
// 文字和统计数据统一在 src/data/siteData.ts 中维护。
import type { Team } from "../data/siteData";
import OptimizedImage from "./OptimizedImage.astro";
import TagList from "./TagList.astro";

type Props = {
  team: Team;
};

const { team } = Astro.props;
---

<div class="team-showcase">
  <div class="team-showcase-media">
    <OptimizedImage src={team.cover} alt={`${team.name}封面`} loading="lazy" />
  </div>
  <div class="team-showcase-content">
    <p class="eyebrow">{team.school}</p>
    <h3>{team.name}</h3>
    <p class="team-slogan">{team.slogan}</p>
    <p>{team.summary}</p>
    <p>{team.detail}</p>
    <TagList items={team.tags} className="tag-list" />
  </div>
</div>
