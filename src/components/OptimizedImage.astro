---
// 卡片、详情页和相册缩略图统一使用的响应式图片组件。
import { withBase } from "../utils/paths";
import { imageSrcSet } from "../utils/images";

type Props = {
  src: string;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  width?: number | string;
  height?: number | string;
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  sizes?: string;
};

const {
  src,
  alt,
  class: className,
  loading = "lazy",
  width,
  height,
  fetchpriority,
  decoding = "async",
  sizes = "(max-width: 720px) 92vw, (max-width: 1200px) 48vw, 640px"
} = Astro.props;

const supportsGeneratedVariants = /\.(png|jpe?g)(?:$|[?#])/i.test(src);
const imageAttrs = {
  src: withBase(src),
  alt,
  class: className,
  loading,
  width,
  height,
  fetchpriority,
  decoding,
  sizes
};
---

{
  supportsGeneratedVariants ? (
    <picture>
      <source srcset={imageSrcSet(src, "avif")} type="image/avif" sizes={sizes} />
      <source srcset={imageSrcSet(src, "webp")} type="image/webp" sizes={sizes} />
      <img {...imageAttrs} />
    </picture>
  ) : (
    <img {...imageAttrs} />
  )
}
