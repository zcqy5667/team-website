---
// 卡片和详情页统一使用的图片组件。
// 如果 PNG 旁边存在同名 WebP 文件，就自动优先提供 WebP 资源。
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { withBase } from "../utils/paths";

type Props = {
  src: string;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  width?: number | string;
  height?: number | string;
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
};

const {
  src,
  alt,
  class: className,
  loading = "lazy",
  width,
  height,
  fetchpriority,
  decoding = "async"
} = Astro.props;

const webpSrc = src.replace(/\.png(?=($|[?#]))/i, ".webp");
const webpFile = webpSrc.startsWith("/") ? webpSrc.slice(1) : webpSrc;
const hasWebp = webpSrc !== src && existsSync(resolve(process.cwd(), "public", webpFile));
// 保证 picture 分支和普通 img 分支使用相同的回退属性。
const imageAttrs = {
  src: withBase(src),
  alt,
  class: className,
  loading,
  width,
  height,
  fetchpriority,
  decoding
};
---

{
  hasWebp ? (
    <picture>
      <source srcset={withBase(webpSrc)} type="image/webp" />
      <img {...imageAttrs} />
    </picture>
  ) : (
    <img {...imageAttrs} />
  )
}
