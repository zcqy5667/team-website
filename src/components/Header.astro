---
// 页头负责导航文字、当前路由判断和移动端菜单状态。
// 新增或删除一级页面时修改 navItems，下面的点击逻辑无需跟着改。
import { team } from "../data/siteData";
import { withBase } from "../utils/paths";

type NavItem = {
  label: string;
  href: string;
  match: string;
};

type Props = {
  currentPath?: string;
};

const { currentPath = "/" } = Astro.props;
const navItems: NavItem[] = [
  { label: "首页", href: "/", match: "/" },
  { label: "战队", href: "/#team", match: "/#team" },
  { label: "兵种", href: "/units/", match: "/units/" },
  { label: "分工", href: "/division/", match: "/division/" },
  { label: "成果", href: "/honors/", match: "/honors/" },
  { label: "联系", href: "/contact/", match: "/contact/" }
];

function isCurrent(item: NavItem) {
  // Team 链接指向首页锚点，用户访问其他页面时不应该显示为当前页面。
  if (item.match === "/#team") return false;
  const normalizedPath = currentPath.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
  if (item.match === "/") return normalizedPath === "/";

  return normalizedPath === item.match || normalizedPath.startsWith(item.match);
}
---

<header class="site-header" data-site-header>
  <a class="site-header-brand" href={withBase("/")}>
    <span>{team.name}</span>
  </a>
  <button
    class="nav-toggle"
    type="button"
    aria-controls="site-menu"
    aria-expanded="false"
    aria-label="Open navigation"
    data-nav-toggle
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav class="main-nav" id="site-menu" aria-label="主导航" data-site-menu>
    {
      navItems.map((item) => (
        <a class:list={{ "is-current": isCurrent(item) }} href={withBase(item.href)}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  // 此脚本只操作当前渲染出的页头，由共享布局引入一次即可。
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-site-menu]");

  if (header && navToggle && menu) {
    const setOpen = (open: boolean) => {
      // 通过同一个函数同步 CSS 状态和无障碍属性。
      const shouldOpen = open && window.matchMedia("(max-width: 820px)").matches;

      header.classList.toggle("is-menu-open", shouldOpen);
      document.documentElement.classList.toggle("is-nav-open", shouldOpen);
      navToggle.setAttribute("aria-expanded", String(shouldOpen));
      navToggle.setAttribute("aria-label", shouldOpen ? "Close navigation" : "Open navigation");
    };

    const closeMenu = () => setOpen(false);

    navToggle.addEventListener("click", () => {
      setOpen(!header.classList.contains("is-menu-open"));
    });

    menu.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });

    window.addEventListener("resize", () => {
      if (window.matchMedia("(min-width: 821px)").matches) closeMenu();
    });

    window.addEventListener("pageshow", closeMenu);
    window.addEventListener("pagehide", closeMenu);
    window.addEventListener("hashchange", closeMenu);
  }
</script>
