---
// 所有 Astro 页面共用的文档外壳。
// 全局样式、页头、页脚和站点级交互统一放在这里，页面文件只关注内容。
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SiteInteractions from "../components/SiteInteractions.astro";
import { team } from "../data/siteData";
import { withBase } from "../utils/paths";
import "../styles/styles.css";

type Props = {
  title: string;
  description: string;
  footerBackHref?: string;
  footerBackLabel?: string;
};

const { title, description, footerBackHref, footerBackLabel } = Astro.props;
const currentPath = Astro.url.pathname;
// 比较当前路由和 "/" 之前，先移除部署环境配置的基础路径。
const normalizedPath = currentPath.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const pageTitle = normalizedPath === "/" ? team.name : `${team.name} | ${title}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- 所有 public 资源 URL 都通过 withBase 处理，以兼容部署在子路径下的情况。 -->
    <link rel="icon" type="image/png" href={withBase(team.emblem)} />
  </head>
  <body class:list={{ "page-home": normalizedPath === "/" }}>
    <Header currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer backHref={footerBackHref} backLabel={footerBackLabel} />
    <SiteInteractions />
  </body>
</html>
