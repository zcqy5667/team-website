---
import Layout from "../layouts/Layout.astro";
import { showcaseAlbums } from "../data/siteData";
import { withBase } from "../utils/paths";

const albumCount = showcaseAlbums.length;
const photoCount = showcaseAlbums.reduce((total, album) => total + album.photos.length, 0);
const videoCount = showcaseAlbums.filter((album) => album.type === "video").length;
const awardAlbumCount = showcaseAlbums.filter((album) => album.type === "awards").length;

function albumMeta(album: (typeof showcaseAlbums)[number]) {
  if (album.type === "gallery") return `${album.photos.length} 张照片`;
  if (album.type === "video") return "赛季影像";
  return `${album.photos.length} 张证书`;
}
---

<Layout
  title="荣誉与成果"
  description="桂林理工大学群星战队的机器人影像、赛季混剪与历年奖项档案。"
  footerBackHref="/"
  footerBackLabel="返回首页"
  enableInteractions={false}
>
  <section
    class="page-hero page-hero-honors"
    style={`--page-hero-image: image-set(url("${withBase("/assets/images/team-cover.webp")}") type("image/webp"), url("${withBase("/assets/images/team-cover.png")}") type("image/png"))`}
  >
    <div class="page-hero-content">
      <p class="eyebrow">HONORS / RESULTS</p>
      <h1>荣誉与成果</h1>
      <p>机器人影像、赛季混剪与历年奖项，集中记录群星战队的赛场历程。</p>
    </div>
  </section>

  <section class="honors-overview" aria-label="成果统计">
    <div class="honors-overview-inner">
      <div class="honors-overview-copy">
        <p class="eyebrow">Archive</p>
        <h2>成果目录</h2>
      </div>
      <div class="honors-stat-grid">
        <div class="honor-stat">
          <span class="honor-stat-value">{String(albumCount).padStart(2, "0")}</span>
          <span class="honor-stat-label">目录</span>
        </div>
        <div class="honor-stat">
          <span class="honor-stat-value">{String(photoCount).padStart(2, "0")}</span>
          <span class="honor-stat-label">照片</span>
        </div>
        <div class="honor-stat">
          <span class="honor-stat-value">{String(videoCount).padStart(2, "0")}</span>
          <span class="honor-stat-label">影像</span>
        </div>
        <div class="honor-stat">
          <span class="honor-stat-value">{String(awardAlbumCount).padStart(2, "0")}</span>
          <span class="honor-stat-label">奖项档案</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section honors-index-section" aria-labelledby="honors-index-title">
    <div class="honors-index-heading">
      <div>
        <p class="eyebrow">Contents</p>
        <h2 id="honors-index-title">查看成果</h2>
      </div>
    </div>
    <nav class="honors-index-nav" aria-label="成果目录">
      {showcaseAlbums.map((album, index) => (
        <a href={withBase(`/honors/${album.slug}/`)}>
          <span class="honors-index-number">{String(index + 1).padStart(2, "0")}</span>
          <span class="honors-index-label">
            <strong>{album.title}</strong>
            <small>{album.description}</small>
          </span>
          <small>{albumMeta(album)}</small>
          <span class="honors-index-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  </section>
</Layout>
