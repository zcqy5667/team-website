---
// 动态分工详情页。getStaticPaths 会在构建时为 divisionGroups 中的每项生成一个静态页面。
import Layout from "../../layouts/Layout.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import TagList from "../../components/TagList.astro";
import { divisionGroups } from "../../data/siteData";
import { withBase } from "../../utils/paths";

const webpPath = (path: string) => path.replace(/\.png(?=($|[?#]))/i, ".webp");

export function getStaticPaths() {
  // 将完整的分工对象作为 props 传入，模板渲染各个路由时无需再次查找数据。
  return divisionGroups.map((group) => ({
    params: { slug: group.slug },
    props: { group }
  }));
}

const { group } = Astro.props;
// 硬件组首屏使用单独的展示图；职责正文继续沿用 group.image。
const heroImage = group.slug === "hardware" ? "/assets/images/yingjian1.png" : group.image;
// CSS 背景图需要拼接 image-set 字符串；内容图片使用 OptimizedImage，
// 以获得相同的 PNG/WebP 回退能力。
const backgroundImage =
  heroImage === "/assets/images/yingjian1.png"
    ? `url("${withBase(heroImage)}")`
    : heroImage.toLowerCase().includes(".png")
      ? `image-set(url("${withBase(webpPath(heroImage))}") type("image/webp"), url("${withBase(heroImage)}") type("image/png"))`
      : `url("${withBase(heroImage)}")`;
---

<Layout title={`RoboMaster ${group.name}`} description={group.summary} footerBackHref="/division/" footerBackLabel="返回分工">
  <section
    class:list={[
      "page-hero",
      "page-hero-division-detail",
      {
        "page-hero-division-algorithm": group.slug === "algorithm",
        "page-hero-division-hardware": group.slug === "hardware"
      }
    ]}
    style={`--page-hero-image: ${backgroundImage}`}
  >
    <div class="page-hero-content">
      <p class="eyebrow">{group.kicker}</p>
      <h1>{group.name}</h1>
      <p>{group.summary}</p>
    </div>
  </section>

  <section class="section division-detail-section" aria-labelledby="division-detail-title">
    <div class="division-detail">
      <div
        class:list={[
          "division-detail-media",
          { "division-detail-media-hardware": group.slug === "hardware" }
        ]}
      >
        <OptimizedImage src={group.image} alt={`${group.name}展示图`} loading="lazy" />
      </div>
      <div class="division-detail-content">
        <p class="eyebrow">Role Detail</p>
        <h2 id="division-detail-title">{group.name}职责</h2>
        <p>{group.detail}</p>
        <TagList items={group.tags} className="tag-list" />
      </div>
    </div>
  </section>

  <section class="section division-responsibility-section" aria-labelledby="division-responsibility-title">
    <div class="section-heading">
      <p class="eyebrow">Responsibilities</p>
      <h2 id="division-responsibility-title">核心职责</h2>
    </div>
    <div class="division-responsibility-grid">
      {
        group.responsibilities.map((responsibility, index) => (
          <article class="division-responsibility-card">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{responsibility}</strong>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
