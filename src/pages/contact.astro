---
// 联系页当前使用页面内占位内容。
// 在建立统一的联系信息数据模型之前，可直接在这里替换内容。
import Layout from "../layouts/Layout.astro";
import { withBase } from "../utils/paths";

const contactItems = [
  {
    label: "招新咨询",
    value: "731699482",
    detail: "面向机械、电控、算法、硬件、运营等方向开放咨询。"
  },
  {
    label: "合作联系",
    value: "2136390097@qq.com",
    detail: "用于校内合作、赛事交流、媒体素材和项目共创沟通。"
  },
  {
    label: "基地地址",
    value: "桂林理工大学主教学楼7栋-1楼",
    detail: "可以线下参观基地，参与招新活动领取精美礼品"
  }
];
---

<Layout title="联系我们" description="桂林理工大学机器人基地联系、招新咨询与合作沟通入口。" footerBackHref="/" footerBackLabel="返回首页">
  <section class="page-hero page-hero-contact" style={`--page-hero-image: image-set(url("${withBase("/assets/images/media-stage.webp")}") type("image/webp"), url("${withBase("/assets/images/media-stage.png")}") type("image/png"))`}>
    <div class="page-hero-content">
      <p class="eyebrow">Contact</p>
      <h1>联系我们</h1>
      <p>欢迎对机器人研发、RoboMaster 赛事、团队招新和校内外合作感兴趣的同学与伙伴联系基地。</p>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="section-heading">
      <p class="eyebrow">Get In Touch</p>
      <h2 id="contact-title">联系入口</h2>
    </div>
    <div class="contact-grid">
      {
        contactItems.map((item) => (
          <article class="contact-card">
            <span>{item.label}</span>
            <strong>{item.value}</strong>
            <p>{item.detail}</p>
            <button class="copy-button" type="button" data-copy-value={item.value} data-copy-label="复制">复制</button>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
